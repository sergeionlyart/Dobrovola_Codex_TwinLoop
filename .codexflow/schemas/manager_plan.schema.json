{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ManagerPlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "spec_path",
    "assumptions",
    "tasks",
    "ordering",
    "created_at"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "spec_path": {
      "type": "string",
      "const": "docs/TECH_SPEC.md"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "title",
          "objective",
          "scope_in",
          "scope_out",
          "dod",
          "quality_gates",
          "required_commands",
          "touched_areas",
          "risk",
          "approval_required",
          "depends_on"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^TSK-[0-9]{4}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "scope_in": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scope_out": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dod": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "quality_gates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required_commands": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "touched_areas": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "risk": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "approval_required": {
            "type": "boolean"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^TSK-[0-9]{4}$"
            }
          }
        }
      }
    },
    "ordering": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "string",
        "pattern": "^TSK-[0-9]{4}$"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
