{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkerReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "status",
    "branch",
    "commits",
    "changed_files",
    "commands_run",
    "tests",
    "summary",
    "risks_or_notes",
    "artifacts",
    "created_at"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^TSK-[0-9]{4}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "DONE",
        "REWORK_NEEDED",
        "FAILED",
        "BLOCKED"
      ]
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "commits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sha",
          "message"
        ],
        "properties": {
          "sha": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commands_run": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cmd",
          "exit_code",
          "notes"
        ],
        "properties": {
          "cmd": {
            "type": "string",
            "minLength": 1
          },
          "exit_code": {
            "type": "integer"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status",
          "notes"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "risks_or_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_json",
        "report_md",
        "worker_log",
        "worker_stderr",
        "worker_evidence"
      ],
      "properties": {
        "report_json": {
          "type": "string",
          "minLength": 1
        },
        "report_md": {
          "type": "string",
          "minLength": 1
        },
        "worker_log": {
          "type": "string",
          "minLength": 1
        },
        "worker_stderr": {
          "type": "string",
          "minLength": 1
        },
        "worker_evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
