# Copy this file to .env and fill values locally.
# Do not commit real secrets.

OPENAI_API_KEY=your_openai_api_key
MONGO_URI=mongodb://localhost:27017
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/gcp-service-account.json

# Optional integration used by operational notifications.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Optional workflow tuning overrides.
CODEXFLOW_OP_PYTHON_BIN=python3
CODEXFLOW_OP_BASE_BRANCH=codex/product/integration
CODEXFLOW_OP_MANAGER_TIMEOUT_SEC=900
CODEXFLOW_OP_WORKER_TIMEOUT_SEC=7200
CODEXFLOW_OP_MAX_ATTEMPTS_WORKER=4
CODEXFLOW_OP_MAX_PLAN_RETRIES=3
CODEXFLOW_OP_MAX_RUN_CYCLES=200
CODEXFLOW_OP_RETRY_BACKOFF_SEC=20
CODEXFLOW_OP_AUTO_APPROVE_TECHNICAL_WAIT=1
CODEXFLOW_LOCK_TTL_SEC=28800
CODEXFLOW_CODEX_EXEC_MAX_ATTEMPTS=2
CODEXFLOW_CODEX_EXEC_RETRY_DELAY_SEC=1
